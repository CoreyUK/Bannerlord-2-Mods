<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>VeteranTroops.MCM</AssemblyName>
    <RootNamespace>VeteranTroops.Mcm</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Win64_Shipping_Client\</OutputPath>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=VeteranTroops.MCM</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <!-- MCM workshop module. Override with -p:McmPath=... to build elsewhere. -->
    <McmPath Condition="'$(McmPath)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\261550\2859238197\bin\Win64_Shipping_Client</McmPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MCMv5">
      <HintPath>$(McmPath)\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VeteranTroops">
      <HintPath>..\bin\Win64_Shipping_Client\VeteranTroops.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
